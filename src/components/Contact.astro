---
import { Image } from 'astro:assets';
import logoWhite from '../assets/logo/ctp-white.png';
import TornEdge from './TornEdge.astro';
import { media } from '../data/media';
---

<section id="kontakt" class="relative overflow-x-clip pt-6 md:pt-6 -mt-30">
  <!-- Wiki / CV / text — shifted down under the black torn edge -->
  <div
    class="relative z-10 mb-[-5.5rem] grid translate-y-8 items-end gap-4 md:mb-[-6.5rem] md:translate-y-12 lg:grid-cols-[2fr_1fr_2fr] lg:items-end lg:gap-0"
  >
    <div class="relative z-0 w-full max-w-none lg:max-w-none">
      <img
        src={media.props.wikiSofa}
        alt="Wiktoria Zgódka"
        width="1064"
        height="1039"
class="-translate-x-22 mt-10 md:mt-10 block w-[min(100%,42rem)] max-w-none object-contain object-left object-bottom sm:w-[min(100%,48rem)] lg:w-[min(70vw,54rem)] xl:w-[min(60vw,58rem)]"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="relative z-20 flex -translate-y-16 justify-center md:-translate-y-30 lg:-ml-[99%] lg:-mt-42 lg:-translate-y-15 lg:justify-start xl:-ml-[135%]">
      <div class="relative origin-center rotate-[-6deg]">
        <span class="cv-shadow-blob cv-shadow-blob--left" aria-hidden="true" />
        <span class="cv-shadow-blob cv-shadow-blob--right" aria-hidden="true" />
        <img
          src={media.props.cvPreview}
          alt="Podgląd CV"
          width="800"
          height="960"
          class="relative z-10 scale-[0.6] w-[min(100%,51rem)] origin-center object-contain md:w-[min(100%,60.5rem)] lg:w-[min(100%,150%)] lg:max-w-[60.5rem] xl:max-w-[76rem]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="-translate-x-4 -translate-y-8 px-2 pb-2 pr-3 pt-2 text-[#545454] md:-translate-x-6 md:-translate-y-2 md:px-2 md:pb-4 md:pr-4 md:pt-2 lg:-translate-x-10 lg:-translate-y-60 lg:pb-6 lg:pl-0 lg:pr-4">
      <h2
        class="font-display text-[clamp(7.4rem,5.5vw,4.75rem)] leading-[0.95] font-extrabold tracking-tight text-balance text-[#545454]"
        style="text-shadow: -3px -3px 0 #a6a6a6"
      >
        Chcesz<br />
        zobaczyć<br />
        moje CV?
      </h2>
      <p
        class="font-display mt-6 text-[clamp(1.75rem,3.5vw,3rem)] font-extrabold tracking-tight text-[#545454]"
        style="text-shadow: -2px -2px 0 #a6a6a6"
      >
        Daj znać!
      </p>
      <a
        href="mailto:poczta.wiktoria.zgodka@gmail.com"
        class="mt-4 inline-flex items-center gap-2.5 text-base text-[#545454] underline decoration-[#545454]/40 underline-offset-4 transition hover:text-accent hover:decoration-accent md:text-lg"
      >
        <svg
          class="h-5 w-5 shrink-0 fill-current md:h-6 md:w-6"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
          ></path>
        </svg>
        poczta.wiktoria.zgodka@gmail.com
      </a>
    </div>
  </div>

  <!-- Black band — pt clears the torn edge + black field above content -->
  <div class="relative z-20 overflow-visible bg-black pt-12 pb-6 md:pt-14 md:pb-7">
    <TornEdge position="top" fill="#000000" variant={2} />

    <div
      class="page-width relative z-10 flex flex-col items-center gap-5 px-4 md:flex-row md:items-center md:justify-between md:gap-8 md:px-6"
    >
      <!-- Left: socials — not clipped by the torn edge -->
      <div class="relative z-10 flex flex-col justify-center gap-3 text-cream">
        <a
          class="group inline-flex items-center gap-4 transition hover:opacity-90 md:gap-6"
          href="https://www.linkedin.com/in/wiktoria-zgodka/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/Logo/linkedin-svgrepo-com.svg"
            alt=""
            width="52"
            height="52"
            class="h-10 w-10 shrink-0 object-contain md:h-12 md:w-12"
            aria-hidden="true"
          />
          <span class="font-display text-xl leading-[1.2] font-ink md:text-2xl">
            Dołącz do mojej<br />sieci na LinkedIn!
          </span>
        </a>

        <a
          class="group inline-flex items-center gap-4 transition hover:opacity-90 md:gap-6"
          href="https://www.facebook.com/profile.php?id=100085117704185"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/Logo/facebook.svg"
            alt=""
            width="52"
            height="52"
            class="h-10 w-10 shrink-0 object-contain md:h-12 md:w-12"
            aria-hidden="true"
          />
          <span class="font-display text-xl leading-[1.2] font-ink md:text-2xl">
            Zaproś mnie<br />na Fejsie!
          </span>
        </a>
      </div>

      <!-- Right logo: object-cover crops empty top/bottom of the square; brand stays large -->
      <a
        href="#top"
        class="relative z-10 flex shrink-0 items-center self-center"
        aria-label="CO TU PISZE — strona główna"
      >
        <Image
          src={logoWhite}
          alt="CO TU PISZE"
          width="1080"
          height="1080"
          class="h-[8.5rem] w-[min(100%,22rem)] object-cover object-center md:h-[10rem] md:w-[26rem]"
          densities={[1, 2]}
        />
      </a>
    </div>
  </div>
</section>
