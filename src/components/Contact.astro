---
import { Image } from 'astro:assets';
import logoWhite from '../assets/logo/ctp-white.png';
import TornEdge from './TornEdge.astro';
import { media } from '../data/media';
---

<section id="kontakt" class="relative -mt-8 overflow-x-clip pt-6 md:pt-6 lg:-mt-30">
  <!-- Wiki / CV / text — mobile: Wiki+CV side by side; lg: collage -->
  <div
    class="relative z-10 mb-0 grid translate-y-0 items-end gap-6 pb-16 md:gap-4 md:pb-20 lg:mb-[-6.5rem] lg:translate-y-12 lg:grid-cols-[2fr_1fr_2fr] lg:items-end lg:gap-0 lg:pb-0"
  >
    <div class="grid grid-cols-[1.15fr_0.85fr] items-end gap-1 sm:gap-2 lg:contents">
      <div class="relative z-0 min-w-0 lg:-mx-10 lg:max-w-none">
        <img
          src={media.props.wikiSofa}
          alt="Wiktoria Zgódka"
          width="1064"
          height="1039"
          class="mt-4 block w-full max-w-none -translate-x-0 object-contain object-left object-bottom lg:mt-10 lg:w-[min(70vw,54rem)] lg:max-w-none lg:-translate-x-22 xl:w-[min(60vw,58rem)]"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="relative z-20 flex translate-y-0 justify-center self-end pr-4 pb-2 sm:pr-6 lg:-ml-[70%] lg:-mt-42 lg:translate-x-6 lg:-translate-y-25 lg:justify-start lg:pr-0 lg:pb-0 xl:-ml-[80%] xl:translate-x-20">
        <!-- scale wrapper (not only img) so side shadows match visual CV -->
        <div class="relative origin-center rotate-[-6deg] lg:scale-[0.48]">
          <span class="cv-shadow-under lg:hidden" aria-hidden="true" />
          <span class="cv-shadow-blob cv-shadow-blob--left hidden lg:block" aria-hidden="true" />
          <span class="cv-shadow-blob cv-shadow-blob--right hidden lg:block" aria-hidden="true" />
          <img
            src={media.props.cvPreview}
            alt="Podgląd CV"
            width="800"
            height="960"
            class="relative z-10 w-full max-w-[9.5rem] origin-center object-contain sm:max-w-[12rem] md:max-w-[14rem] lg:w-[min(100%,40rem)] lg:max-w-[40rem] xl:max-w-[44rem]"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="col-span-full translate-x-0 translate-y-0 px-4 pb-6 pr-4 pt-2 text-center text-[#545454] md:px-6 md:pb-8 md:pr-6 md:pt-2 lg:col-span-1 lg:-translate-x-10 lg:-translate-y-60 lg:px-0 lg:pb-6 lg:pl-18 lg:pr-4 lg:text-left">
      <h2
        class="font-display text-[clamp(2.75rem,8vw,4.75rem)] leading-[0.95] font-extrabold tracking-tight text-balance text-[#545454] lg:text-[length:max(6.4rem,5.5vw)]"
        style="text-shadow: -3px -3px 0 #a6a6a6"
      >
        Chcesz<br />
        zobaczyć<br />
        moje CV?
      </h2>
      <p
        class="font-display mt-6 text-[clamp(1.5rem,3.5vw,3rem)] font-extrabold tracking-tight text-[#545454]"
        style="text-shadow: -2px -2px 0 #a6a6a6"
      >
        Daj znać!
      </p>
      <a
        href="mailto:poczta.wiktoria.zgodka@gmail.com"
        class="mt-4 inline-flex max-w-full items-center gap-2.5 break-all text-base text-[#545454] underline decoration-[#545454]/40 underline-offset-4 transition hover:text-accent hover:decoration-accent md:text-lg"
      >
        <svg
          class="h-5 w-5 shrink-0 fill-current md:h-6 md:w-6"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
          ></path>
        </svg>
        poczta.wiktoria.zgodka@gmail.com
      </a>
    </div>
  </div>

  <!-- Black band — pt clears the torn edge + black field above content -->
  <div class="relative z-20 overflow-visible bg-black pt-12 pb-6 md:pt-14 md:pb-7">
    <TornEdge position="top" fill="#000000" variant={2} />

    <div
      class="page-width relative z-10 flex flex-col items-center gap-5 px-4 md:flex-row md:items-center md:justify-between md:gap-8 md:px-6"
    >
      <!-- Left: socials — not clipped by the torn edge -->
      <div class="relative z-10 flex flex-col justify-center gap-3 text-cream">
        <a
          class="group inline-flex items-center gap-4 transition hover:opacity-90 md:gap-6"
          href="https://www.linkedin.com/in/wiktoria-zgodka/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/icons/linkedin.svg"
            alt=""
            width="52"
            height="52"
            class="h-10 w-10 shrink-0 object-contain md:h-12 md:w-12"
            aria-hidden="true"
          />
          <span class="font-display text-xl leading-[1.2] font-ink md:text-2xl">
            Dołącz do mojej<br />sieci na LinkedIn!
          </span>
        </a>

        <a
          class="group inline-flex items-center gap-4 transition hover:opacity-90 md:gap-6"
          href="https://www.facebook.com/profile.php?id=100085117704185"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/icons/facebook.svg"
            alt=""
            width="52"
            height="52"
            class="h-10 w-10 shrink-0 object-contain md:h-12 md:w-12"
            aria-hidden="true"
          />
          <span class="font-display text-xl leading-[1.2] font-ink md:text-2xl">
            Zaproś mnie<br />na Fejsie!
          </span>
        </a>
      </div>

      <!-- Right logo: object-cover crops empty top/bottom of the square; brand stays large -->
      <a
        href="#top"
        class="relative z-10 flex shrink-0 items-center self-center"
        aria-label="CO TU PISZE — strona główna"
      >
        <Image
          src={logoWhite}
          alt="CO TU PISZE"
          width="1080"
          height="1080"
          class="h-[8.5rem] w-[min(100%,22rem)] object-cover object-center md:h-[10rem] md:w-[26rem]"
          densities={[1, 2]}
        />
      </a>
    </div>
  </div>
</section>
