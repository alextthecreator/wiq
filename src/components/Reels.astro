---
import fs from 'node:fs';
import path from 'node:path';
import { media } from '../data/media';

const videosDir = path.join(process.cwd(), 'public', 'videos');
const videoFiles = fs.existsSync(videosDir)
  ? fs
      .readdirSync(videosDir)
      .filter((f) => /\.(mp4|webm|mov)$/i.test(f))
      .sort()
  : [];

const SLOT_COUNT = 8; // 2 rows × 4

const reels = Array.from({ length: SLOT_COUNT }, (_, i) => {
  const file = videoFiles[i];
  return {
    title: `Montaż ${String(i + 1).padStart(2, '0')}`,
    src: file ? `/videos/${file}` : null,
  };
});
---

<section class="relative px-4 pt-20 pb-3 md:px-6 md:pt-28 md:pb-6">
  <div class="page-width relative z-10">
    <h2 class="font-display text-4xl font-extrabold tracking-tight text-ink text-balance md:text-6xl lg:text-9xl">
      Przykłady moich <br />montaży
    </h2>

    <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {
        reels.map((reel) => (
          <figure class="paper-shadow overflow-hidden bg-ink">
            <div class="relative aspect-[9/16] bg-ink">
              {reel.src ? (
                <>
                  <video
                    class="absolute inset-0 h-full w-full object-cover"
                    controls
                    playsinline
                    preload="metadata"
                    poster={media.photos.wiki2}
                  >
                    <source src={reel.src} type="video/mp4" />
                  </video>
                  <figcaption class="pointer-events-none absolute bottom-0 inset-x-0 bg-gradient-to-t from-ink/80 to-transparent p-3 text-xs text-cream md:p-4 md:text-sm">
                    {reel.title}
                  </figcaption>
                </>
              ) : (
                <div
                  class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-ink/90 px-3 text-center"
                  aria-label={`Placeholder ${reel.title}`}
                >
                  <span class="font-display text-sm font-bold text-cream/70">{reel.title}</span>
                  <span class="text-[0.7rem] leading-snug text-cream/40">
                    Wrzuć .mp4 do public/videos/
                  </span>
                </div>
              )}
            </div>
          </figure>
        ))
      }
    </div>

    <blockquote class="mt-10 w-full">
      <p class="font-display text-3xl font-bold leading-snug text-ink md:text-5xl text-balance">
        „Ale ja nie umiem gadać do kamery”.
      </p>
      <p class="mt-5 w-full text-xl leading-relaxed text-ink-soft md:text-2xl">
        <strong class="font-bold text-ink">Umiesz.</strong> Większość osób, z jakimi pracuję, ma z
        tym spory problem. Ja jestem od tego, by nauczyć Cię swobody. Gwarantuję atmosferę, która
        pozwoli Ci się otworzyć i nagrać, co tylko chcesz :)
      </p>
    </blockquote>
  </div>
</section>
