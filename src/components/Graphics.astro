---
import { media } from '../data/media';

const rotates = [-2, 1.5, -1, 2, -1.5, 1, -1.2, 1.8, -0.8, 2.2, -1.6, 0.9, -2.1, 1.3, -0.5];

const sources = [
  { src: media.graphics.work1, alt: 'Grafika MissionOne — BANI' },
  { src: media.graphics.work2, alt: 'Przykład grafiki social media' },
  { src: media.graphics.work3, alt: 'Przykład identyfikacji wizualnej' },
  { src: media.graphics.work4, alt: 'Przykład postu / creative' },
  { src: media.graphics.work5, alt: 'Przykład grafiki do publikacji' },
  { src: media.graphics.ctpGif, alt: 'Animacja — Konferencja KIKE' },
  { src: media.graphics.ctp1Gif, alt: 'Animacja — Canna Vitis' },
];

const SLOT_COUNT = 15; // 5 rows × 3

const works = Array.from({ length: SLOT_COUNT }, (_, i) => ({
  ...(sources[i] ?? { src: null as string | null, alt: `Grafika ${i + 1}` }),
  rotate: rotates[i] ?? 0,
  index: i + 1,
}));
---

<section id="portfolio" class="px-4 py-20 md:px-6 md:py-28">
  <div class="page-width text-wrap">
    <h2 class="font-display pr-60 text-9xl font-extrabold tracking-tight text-ink text-balance md:text-20xl">
      Przykłady moich
      <br />grafik
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        works.map((work) => (
          <figure
            class="paper-shadow overflow-hidden bg-cream p-2 transition duration-500 hover:-translate-y-1"
            style={`transform: rotate(${work.rotate}deg)`}
          >
            {work.src ? (
              <img
                src={work.src}
                alt={work.alt}
                width="720"
                height="900"
                class="aspect-[4/5] w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div
                class="flex aspect-[4/5] w-full flex-col items-center justify-center gap-2 bg-[repeating-linear-gradient(-45deg,#eceae4,#eceae4_12px,#e4e1d8_12px,#e4e1d8_24px)] text-ink-soft"
                aria-label={`Placeholder grafiki ${work.index}`}
              >
                <span class="font-display text-sm font-bold tracking-wide uppercase opacity-60">
                  Grafika {String(work.index).padStart(2, '0')}
                </span>
                <span class="max-w-[12ch] text-center text-xs opacity-50">Wkrótce</span>
              </div>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>
