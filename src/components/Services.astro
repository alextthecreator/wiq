---
import { media } from '../data/media';

const services = [
  { text: 'Pomagam konsekwentnie budować', strong: 'marki osobiste' },
  { text: 'Wspieram przy kreowaniu', strong: 'identyfikacji wizualnych' },
  { text: 'Montuję', strong: 'rolki', text2: 'i tworzę', strong2: 'grafiki', text3: 'na social media' },
  { text: 'Uczę, jak dobrze', strong: 'korzystać z LinkedIna' },
  { text: 'Piszę różnorodne', strong: 'materiały tekstowe', text2: 'do publikacji' },
  { text: '', strong: 'Redaguję', text2: 'teksty i dbam o ich poprawność językową' },
  { text: 'Zajmuję się', strong: 'tłumaczeniem tekstów anglojęzycznych' },
];
---

<section id="uslugi" class="relative px-5 py-20 md:px-10 md:py-5">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-16">
    <div class="mx-auto w-full max-w-sm lg:mx-0">
      <div class="paper-shadow overflow-hidden rotate-[-2deg]">
        <img
          src={media.photos.wiki6}
          alt="Portret Wiki w białej koszuli"
          width="640"
          height="853"
          class="aspect-[3/4] w-full object-cover object-top"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="text-[#545454]">

      <p class="font-amicale mt-2 w-full text-4xl font-bold tracking-tight text-[#545454] md:text-9xl text-balance">
        Czym się
      </p>
      <p class="font-amicale mt-2 w-full text-4xl font-bold tracking-tight text-[#545454] md:text-9xl text-balance">
        zajmuję?
      </p>
      <ul class="mt-8 space-y-0">
        {
          services.map((item) => (
            <li class="flex items-start gap-3 py-1.5">
              <span
                class="mt-[0.35em] h-[1em] w-[1em] shrink-0 rounded-full bg-[#545454]"
                aria-hidden="true"
              />
              <p class="text-lg leading-snug text-[#545454] md:text-xl">
                {item.text && <>{item.text}{' '}</>}
                <strong class="font-semibold text-[#545454]">{item.strong}</strong>{item.text2 && <>{' '}{item.text2}</>}{item.strong2 && <>{' '}<strong class="font-semibold text-[#545454]">{item.strong2}</strong></>}{item.text3 && <>{' '}{item.text3}</>}.
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
