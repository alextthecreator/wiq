---
import { media } from '../data/media';

const services = [
  { text: 'Pomagam konsekwentnie budować', strong: 'marki osobiste' },
  { text: 'Wspieram przy kreowaniu', strong: 'identyfikacji wizualnych' },
  { text: 'Montuję', strong: 'rolki', text2: 'i tworzę', strong2: 'grafiki', text3: 'na social media' },
  { text: 'Uczę, jak dobrze', strong: 'korzystać z LinkedIna' },
  { text: 'Piszę różnorodne', strong: 'materiały tekstowe', text2: 'do publikacji' },
  { text: '', strong: 'Redaguję', text2: 'teksty i dbam o ich poprawność językową' },
  { text: 'Zajmuję się', strong: 'tłumaczeniem tekstów anglojęzycznych' },
];
---

<!-- overflow-visible: otherwise overflow-x-clip clips Wiki sticking out on the left -->
<section id="uslugi" class="relative overflow-visible pb-0 pt-16 md:pt-20">
  <!-- Clip + note: 150%, behind polaroids/Wiki -->
  <div
    class="pointer-events-none absolute left-[max(0.5rem,calc((100%-min(100%,96rem))/2))] top-0 z-[1] w-[min(420px,72vw)] -translate-y-[42%] rotate-[-14deg] md:w-[min(510px,48vw)]"
  >
    <div class="relative pt-14 md:pt-16">
      <img
        src={media.props.clip}
        alt=""
        width="304"
        height="282"
        class="pointer-events-none absolute left-1/2 top-0 z-10 h-32 w-auto -translate-x-1/2 -translate-y-[28%] drop-shadow-md md:h-36"
        aria-hidden="true"
        decoding="async"
      />
      <div class="relative">
        <img
          src={media.props.notePaper}
          alt=""
          width="320"
          height="400"
          class="block w-full drop-shadow-lg"
          decoding="async"
        />
        {/* 3 lines centered on the note; rhythm ≈ paper line gap (~8.5% of height) */}
        <p
          class="font-hand absolute inset-x-[10%] top-[27%] grid h-[25.5%] grid-rows-3 text-center text-[clamp(3.15rem,4.4vw,1.55rem)] leading-[0.7] text-ink/90"
        >
          <span class="flex translate-y-[0.12em] items-end justify-center">Posty, newslettery,</span>
          <span class="flex translate-y-[0.12em] items-end justify-center">mailingi, artykuły, opisy,</span>
          <span class="flex translate-y-[0.12em] items-end justify-center">grafiki, rolki…</span>
        </p>
      </div>
    </div>
  </div>

  <div class="relative z-10 grid items-end gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-2">
    <!--
      Wiki: flush to the left viewport edge + translateX(-21.5%)
      (PNG has ~21.5% empty background on the left of the figure)
    -->
    <div class="relative z-20 overflow-visible">
      <img
        src={media.props.servicesLeft}
        alt="Wiktoria Zgódka"
        width="800"
        height="664"
        class="relative z-20 mb-[-2.5rem] block w-[min(95vw,50rem)] max-w-none object-contain object-left object-bottom md:mb-[-3.25rem] lg:w-[min(60vw,54rem)]"
        style="margin-left: calc(80% - 50vw); transform: translateX(-21.5%);"
        loading="lazy"
        decoding="async"
      />

      <img
        src={media.props.polaroidLaptop}
        alt=""
        width="191"
        height="208"
        class="pointer-events-none absolute top-[10%] right-[20%] z-30 w-[min(38%,11rem)] rotate-[-8deg] drop-shadow-md md:top-[6%] md:w-[min(42%,13rem)] lg:w-[12.5rem]"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
<img
  src={media.props.polaroidEdit}
  alt=""
  width="355"
  height="375"
  class="pointer-events-none absolute bottom-[-5%] right-[20%] z-10 w-[min(75%,14.5rem)] rotate-[6deg] drop-shadow-lg md:bottom-[28%] md:w-[min(55%,17rem)] lg:w-[18rem]"
  aria-hidden="true"
  loading="lazy"
  decoding="async"
/>
    </div>

    <div class="relative z-10 px-4 pb-10 text-[#545454] md:px-6 md:pb-34 lg:pr-8 lg:pl-2">
      <p class="font-amicale mt-2 w-full text-4xl font-bold tracking-tight text-[#545454] md:text-8xl xl:text-9xl text-balance">
        Czym się
      </p>
      <p class="font-amicale mt-2 w-full text-4xl font-bold tracking-tight text-[#545454] md:text-8xl xl:text-9xl text-balance">
        zajmuję?
      </p>
      <ul class="mt-8 max-w-xl space-y-0">
        {
          services.map((item) => (
            <li class="flex items-start gap-3 py-1.5">
              <span
                class="mt-[0.35em] h-[1em] w-[1em] shrink-0 rounded-full bg-[#545454]"
                aria-hidden="true"
              />
              <p class="text-lg leading-snug text-[#545454] md:text-xl"
              >{item.text && <>{item.text}{' '}</>}<strong class="font-semibold text-[#545454]">{item.strong}</strong>{item.text2 && <>{' '}{item.text2}</>}{item.strong2 && <>{' '}<strong class="font-semibold text-[#545454]">{item.strong2}</strong></>}{item.text3 && <>{' '}{item.text3}</>}.</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
