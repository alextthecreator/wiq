---
import tear1 from '../assets/paper/tear-edge-1.png';
import tear2 from '../assets/paper/tear-edge-2.png';

interface Props {
  position?: 'top' | 'bottom';
  /** Color of the paper piece (usually the section BELOW/ABOVE that "covers") */
  fill?: string;
  class?: string;
}
const { position = 'bottom', fill = '#eceae4', class: className = '' } = Astro.props;
const tiles = [tear1, tear2, tear1, tear2];
---

<div
  class:list={[
    'pointer-events-none absolute inset-x-0 z-20 leading-[0]',
    position === 'top' ? '-top-px' : '-bottom-px',
    className,
  ]}
  style={position === 'top' ? 'transform: scaleY(-1)' : undefined}
  aria-hidden="true"
>
  <div class="flex w-full" style={`color: ${fill}`}>
    {
      tiles.map((src) => (
        <div
          class="h-[42px] w-1/4 md:h-[56px]"
          style={`
            background-color: ${fill};
            -webkit-mask-image: url(${src.src});
            mask-image: url(${src.src});
            -webkit-mask-size: 100% 100%;
            mask-size: 100% 100%;
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
          `}
        />
      ))
    }
  </div>
</div>
