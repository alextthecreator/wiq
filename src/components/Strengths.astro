---
const strengths = [
  { title: 'Znam trendy,', line: 'rozumiem memy' },
  { title: 'Lubię ludzi', line: '' },
  { title: 'Mam doświadczenie', line: 'w wielu branżach' },
  { title: 'Nikogo nie udaję,', line: 'jestem szczera' },
  { title: 'Robię to, bo to', line: 'naprawdę kocham' },
  { title: 'Szybko odpisuję', line: '' },
];
---

<section class="px-4 pt-28 pb-6 md:px-6 md:pt-32 md:pb-6">
  <div class="page-width">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:items-start">
      <h2 class="font-display text-9xl font-extrabold tracking-tight text-ink text-balance md:text-25xl">
        Moje mocne strony
      </h2>
      <div class="hidden lg:block" aria-hidden="true"></div>
    </div>

    <ul class="mx-40 mt-16 grid items-stretch gap-9 sm:grid-cols-2 md:mt-24 lg:grid-cols-3 lg:gap-15">
      {
        strengths.map((item) => (
          <li class="relative flex h-full flex-col pb-3">
            <span class="strength-shadow-blob" aria-hidden="true" />
            <div class="relative z-10 flex h-full min-h-[6.5rem] items-center justify-center rounded-[3rem] bg-white px-8 py-8 text-center md:min-h-[6rem] md:px-2 md:py-3">
              <p class="font-hand w-full text-[clamp(1.75rem,2.8vw,2.75rem)] font-bold leading-[1.15] text-ink">
                {item.title}
                {item.line && (
                  <>
                    <br />
                    {item.line}
                  </>
                )}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
