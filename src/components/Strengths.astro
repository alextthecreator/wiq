---
const strengths = [
  { title: 'Znam trendy,', line: 'rozumiem memy' },
  { title: 'Lubię ludzi', line: '' },
  { title: 'Mam doświadczenie', line: 'w wielu branżach' },
  { title: 'Nikogo nie udaję,', line: 'jestem szczera' },
  { title: 'Robię to, bo to', line: 'naprawdę kocham' },
  { title: 'Szybko odpisuję', line: '' },
];
---

<section class="px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:items-start">
      <h2 class="font-display text-8xl font-extrabold tracking-tight text-ink text-balance md:text-20xl">
        Moje mocne strony
      </h2>
      <div class="hidden lg:block" aria-hidden="true"></div>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        strengths.map((item) => (
          <li class="flex min-h-[9.5rem] items-center justify-center rounded-[2rem] bg-white px-6 py-8 text-center shadow-[0_10px_0_0_rgb(42_42_40_/_0.18),0_18px_28px_-8px_rgb(42_42_40_/_0.22)] md:min-h-[11rem] md:px-8 md:py-10">
            <p class="font-hand w-full text-[clamp(1.75rem,2.8vw,2.75rem)] font-bold leading-[1.15] text-ink">
              {item.title}
              {item.line && (
                <>
                  <br />
                  {item.line}
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
