---
import { Image } from 'astro:assets';
import logoBlack from '../assets/logo/ctp-black.png';
import { media } from '../data/media';

/** Crop 40% from the top — keep bottom 60%; desk bottom = section bottom */
const HERO_W = 1366;
const HERO_H = 1159;
const CROP_TOP = 0.4;
const visibleH = HERO_H * (1 - CROP_TOP);
---

<section id="top" class="relative overflow-hidden px-4 pt-28 md:px-6 md:pt-32">
  <div
    class="relative z-0 w-full overflow-hidden"
    style={`aspect-ratio: ${HERO_W} / ${visibleH};`}
  >
    <img
      src={media.props.heroBg}
      alt=""
      width={HERO_W}
      height={HERO_H}
      class="pointer-events-none absolute inset-x-0 bottom-0 w-full max-w-none"
      fetchpriority="high"
      decoding="async"
      aria-hidden="true"
    />
  </div>

  <a
    href="#top"
    class="reveal group absolute top-6 right-8 z-20 inline-flex md:top-8 md:right-16"
    aria-label="CO TU PISZE — strona główna"
  >
    <Image
      src={logoBlack}
      alt="CO TU PISZE"
      width={352}
      height={352}
      class="h-56 w-56 object-contain drop-shadow-md transition duration-500 group-hover:rotate-[-4deg] md:h-62 md:w-62"
      densities={[1, 2]}
    />
  </a>

  <div class="page-width absolute inset-x-0 top-0 z-10 px-4 pt-28 md:px-6 md:pt-32">
    <div class="relative z-10 flex max-w-xl flex-col items-stretch">
      <h1
        class="reveal text-[#848484] font-display flex w-max max-w-full flex-col items-start text-[clamp(4.8rem,12vw,10.6rem)] leading-[0.95] font-extrabold tracking-tight"
      >
        Hejka!
        <span class="ml-[0.22em]">Jestem</span>
        <span class="ml-[0.04em]">Wiki</span>
      </h1>
    </div>
  </div>
</section>
