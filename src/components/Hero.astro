---
import { media } from '../data/media';
---

<section id="top" class="relative overflow-visible px-5 pb-24 pt-28 md:px-10 md:pb-32 md:pt-32">
  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1fr] lg:gap-12">
    <div class="relative z-10">
      <p class="reveal font-hand text-2xl text-accent md:text-3xl">hejka!</p>
      <h1 class="reveal reveal-delay-1 font-display mt-2 max-w-[11ch] text-[clamp(2.8rem,8vw,5.6rem)] leading-[0.92] font-extrabold tracking-tight text-ink text-balance">
        Jestem Wiki
      </h1>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
      <div class="relative aspect-[4/5] paper-shadow overflow-hidden rotate-[1.5deg]">
        <img
          src={media.photos.wiki4}
          alt="Wiktoria Zgódka przy biurku"
          width="960"
          height="1200"
          class="h-full w-full object-cover object-[50%_20%]"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <!-- Lined note sits on Hero / Services boundary -->
      <div class="clip-wiggle absolute -bottom-10 left-1/2 z-30 w-[min(220px,55%)] -translate-x-1/2 md:-bottom-12 md:left-auto md:right-[-4%] md:translate-x-0">
        <div class="relative">
          <svg
            class="absolute -top-4 left-1/2 z-10 h-10 w-10 -translate-x-1/2 text-[#8a8f96] drop-shadow"
            viewBox="0 0 64 64"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M22 8h20c3.3 0 6 2.7 6 6v6h-4V14c0-1.1-.9-2-2-2H22c-1.1 0-2 .9-2 2v6h-4v-6c0-3.3 2.7-6 6-6zm-8 14h36v30c0 3.3-2.7 6-6 6H20c-3.3 0-6-2.7-6-6V22zm8 8v18h4V30h-4zm10 0v18h4V30h-4zm10 0v18h4V30h-4z"
            ></path>
          </svg>
          <div class="rounded-[2px] border border-black/5 bg-[#f4f1e6] px-4 pt-7 pb-4 shadow-lg">
            <div class="space-y-1 bg-[repeating-linear-gradient(transparent,transparent_27px,#c9d6e8_28px)] pt-1">
              <p class="font-hand text-[1.35rem] leading-[1.75rem] text-ink/90">
                Posty, newslettery,<br />
                mailingi, artykuły,<br />
                opisy, grafiki, rolki…
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>
