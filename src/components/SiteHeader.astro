---
import { Image } from 'astro:assets';
import logoBlack from '../assets/logo/ctp-black.png';
---

<header class="absolute inset-x-0 top-0 z-30 px-5 pt-5 md:px-10 md:pt-7">
  <div class="mx-auto flex max-w-6xl items-start justify-between gap-4">
    <a href="#top" class="group inline-flex items-center gap-3" aria-label="CO TU PISZE — strona główna">
      <Image
        src={logoBlack}
        alt="CO TU PISZE"
        width={72}
        height={72}
        class="h-12 w-12 object-contain transition duration-500 group-hover:rotate-[-4deg] md:h-14 md:w-14"
        densities={[1, 2]}
      />
      <span class="leading-tight">
        <span class="font-display block text-[0.7rem] font-bold tracking-[0.18em] text-ink uppercase md:text-xs">
          Co tu pisze
        </span>
        <span class="font-body block text-[0.68rem] tracking-wide text-ink-soft md:text-xs">
          Wiktoria Zgódka
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-ink-soft md:flex" aria-label="Nawigacja">
      <a class="transition hover:text-accent" href="#uslugi">Usługi</a>
      <a class="transition hover:text-accent" href="#o-mnie">O mnie</a>
      <a class="transition hover:text-accent" href="#portfolio">Portfolio</a>
      <a class="transition hover:text-accent" href="#kontakt">Kontakt</a>
    </nav>
  </div>
</header>
